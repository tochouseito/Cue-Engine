{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-vs2026",
            "displayName": "Windows x64 - Visual Studio 2026",
            "description": "Configure the CueEngine Rebuild baseline for Visual Studio 2026 on Windows x64.",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}"
        }
    ],
    "buildPresets": [
        {
            "name": "windows-vs2026-debug",
            "displayName": "Windows x64 Debug",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2026-release",
            "displayName": "Windows x64 Release",
            "configurePreset": "windows-vs2026",
            "configuration": "Release"
        }
    ]
}
