{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-vs2026",
            "displayName": "Windows x64 - Visual Studio 2026",
            "description": "Configure the CueEngine Rebuild baseline for Visual Studio 2026 on Windows x64.",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/CMake/CueVcpkgToolchain.cmake",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/ThirdParty",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/ThirdParty/vcpkg_installed",
                "VCPKG_MANIFEST_INSTALL": "OFF",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-vs2026-debug",
            "displayName": "Windows x64 Debug",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2026-development",
            "displayName": "Windows x64 Development",
            "configurePreset": "windows-vs2026",
            "configuration": "Development"
        },
        {
            "name": "windows-vs2026-release",
            "displayName": "Windows x64 Release",
            "configurePreset": "windows-vs2026",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-vs2026-debug",
            "displayName": "Windows x64 Debug Tests",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-vs2026-development",
            "displayName": "Windows x64 Development Tests",
            "configurePreset": "windows-vs2026",
            "configuration": "Development",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-vs2026-release",
            "displayName": "Windows x64 Release Tests",
            "configurePreset": "windows-vs2026",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
